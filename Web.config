<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="KhedutPlusDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=KhedutPlusDB;Integrated Security=True;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Use classic Web Forms validation (zero jQuery required) -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages enableEventValidation="true">
      <controls>
        <add tagPrefix="khedut" tagName="FarmerNavbar" src="~/UserControls/FarmerNavbar.ascx" />
        <add tagPrefix="khedut" tagName="FarmerFooter" src="~/UserControls/FarmerFooter.ascx" />
        <add tagPrefix="khedut" tagName="FarmerSidebar" src="~/UserControls/FarmerSidebar.ascx" />
        <add tagPrefix="khedut" tagName="ShopSidebar" src="~/UserControls/ShopSidebar.ascx" />
        <add tagPrefix="khedut" tagName="AdminSidebar" src="~/UserControls/AdminSidebar.ascx" />
      </controls>
    </pages>
  </system.web>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <modules runAllManagedModulesForAllRequests="true" />
    <directoryBrowse enabled="false" />
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
